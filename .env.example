# No environment variables are required for the quiz and browser-canvas portrait generation.
# Feedback collection is optional. Without the variables below, users can submit the survey UI,
# but the server responds with stored=false and no cross-user feedback is collected.

# Option A: forward feedback payloads to a webhook endpoint.
# FEEDBACK_WEBHOOK_URL=https://example.com/feedback-webhook

# Option B: store feedback rows in Supabase through the serverless API.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-insert-key
# SUPABASE_SECRET_KEY=sb_secret_your-server-only-admin-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-service-role-key
# SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_FEEDBACK_TABLE=ideal_type_feedback

# Option C: email every accepted feedback response through Resend.
# RESEND_API_KEY=re_your-server-only-resend-key
# FEEDBACK_EMAIL_TO=mokky@mokky.store
# FEEDBACK_EMAIL_FROM=Love Feedback <feedback@mokky.store>
