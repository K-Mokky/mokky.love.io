# Vercel Serverless Functions
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=jpeg

# Supabase REST insert target
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# If you do not want to use a service role key, set one of these instead and keep RLS insert policy enabled.
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_RESULTS_TABLE=ideal_type_results
